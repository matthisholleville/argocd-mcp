# ArgoCD connection
ARGOCD_BASE_URL=https://argocd.example.com
ARGOCD_TOKEN=your-argocd-token

# Auth mode: "token" (default), "oauth" (ArgoCD's bundled Dex) or "oidc"
# (the external provider ArgoCD trusts via oidc.config, no Dex involved)
AUTH_MODE=token

# Override if ArgoCD spec is at a non-standard path
# ARGOCD_SPEC_URL=

# Needed for AUTH_MODE=oauth and AUTH_MODE=oidc
# SERVER_BASE_URL=https://mcp.example.com

# AUTH_MODE=oidc: leave issuer and client id empty to read both from ArgoCD's
# own oidc.config. Set them together to override.
# OIDC_ISSUER=https://example.okta.com
# OIDC_CLIENT_ID=0oa1234567890abcdef
# Only for providers that treat the client as confidential; public/PKCE
# clients need no secret.
# OIDC_CLIENT_SECRET=
# OIDC_SCOPES=openid profile email groups
# Register {SERVER_BASE_URL}/oauth/callback at the provider and let this server
# relay codes back to MCP clients (default). Set false only for a provider that
# accepts arbitrary loopback redirects, as Dex does.
# OIDC_PROXY_CALLBACK=false
# Some providers only emit a claim when asked. ArgoCD RBAC needs groups.
# OIDC_REQUESTED_ID_TOKEN_CLAIMS={"id_token":{"groups":{"essential":true}}}
# Non-loopback client redirect_uri values to accept. Loopback is always
# accepted; with OIDC_PROXY_CALLBACK the provider no longer validates the
# client's redirect_uri, so anything else has to be listed here.
# OIDC_ALLOWED_REDIRECT_URIS=https://claude.ai/api/mcp/auth_callback
# Shared key (min 32 chars) the callback state is signed with. Required to run
# more than one replica: any replica can serve the browser's callback and only
# the one that minted the state can verify it.
# OIDC_STATE_KEY=

# TLS: skip certificate verification for self-signed certs (default: false)
# ARGOCD_TLS_INSECURE=true

# Security: block all write operations (POST, PUT, PATCH, DELETE)
# DISABLE_WRITE=true

# Security: restrict to specific resource types (comma-separated OpenAPI tags)
# Combines with DISABLE_WRITE for fine-grained control.
# Available tags: AccountService, ApplicationService, ApplicationSetService,
#   CertificateService, ClusterService, GPGKeyService, NotificationService,
#   ProjectService, RepoCredsService, RepositoryService, SessionService,
#   SettingsService, VersionService
# ALLOWED_RESOURCES=ApplicationService,ProjectService

# Tool mode: "search" (default, 2 meta-tools) or "generated" (1 tool per endpoint).
# Use "generated" with clients that support deferred loading (Claude Code, Claude Desktop).
# TOOL_MODE=generated

# Rate limiting: max execute_operation requests per second per user (0 = disabled)
# In static token mode, all clients share one bucket — prefer OAuth for multi-user setups.
# RATE_LIMIT=10
# RATE_LIMIT_BURST=10
